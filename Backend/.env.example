MONGO_URL=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
GOOGLE_AI_API_KEY=your_google_ai_api_key

# Allowed frontend origin(s) for CORS (comma-separated for multiple).
# Defaults to http://localhost:5173 (Vite dev server) if not set.
CLIENT_URL=http://localhost:5173

# Auth cookie behavior
# sameSite: "lax" (default) works when the frontend + API share a site.
# Use COOKIE_SAMESITE=none for cross-origin HTTPS deployments (e.g. Vercel frontend + separate API host).
# secure: defaults to true when NODE_ENV=production. Override with COOKIE_SECURE=true/false.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
