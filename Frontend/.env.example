# Frontend environment variables (copied by Vite at build time).
# Create this file as Frontend/.env if you need production overrides.

# In production, point the frontend at your deployed API.
# (In development this is optional — the Vite dev server proxies /api/* to
# http://localhost:3000 automatically, see vite.config.js.)
# VITE_API_URL=https://your-api-host
