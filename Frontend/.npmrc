# The project pins eslint@10 but eslint-plugin-react-hooks@5.x (and
# react-refresh@0.4.x) still declare peer ranges capped at eslint ^9.
# npm refuses to resolve that with strict peers on a fresh install (Vercel
# fails with ERESOLVE). These plugins run fine against ESLint 10 in practice
# — this lockfile already records eslint 10.8.1 + react-hooks 5.2.0 — so relax
# peer validation everywhere (local dev, CI, Vercel) instead of papering it
# over with a one-off --legacy-peer-deps on the deploy.
legacy-peer-deps=true
